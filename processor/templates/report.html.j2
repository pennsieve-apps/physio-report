{%- macro table(t, cls='') -%}
<div class="tablewrap"><table class="{{ cls }}">
<thead><tr>{% for h in t.header %}<th{% if loop.index0 > 0 and t.kinds and t.kinds[loop.index0] != 'text' %} class="num"{% endif %}>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>{% for r in t.rows %}<tr>{% for c in r %}<td{% if loop.index0 > 0 and t.kinds and t.kinds[loop.index0] != 'text' %} class="num"{% endif %}>{{ c }}</td>{% endfor %}</tr>
{% endfor %}</tbody></table></div>
{%- endmacro -%}
{%- macro licence_text(l) -%}{% for seg in l.segments %}{% if seg.url %}<a href="{{ seg.url }}">{{ seg.text }}</a>{% else %}{{ seg.text }}{% endif %}{% endfor %}{% if l.url %} <a href="{{ l.url }}">{{ l.url }}</a>{% endif %}{% if l.refs %} Please cite {{ l.refs|refs }}.{% endif %}{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="generator" content="Pennsieve physio-report {{ m.version }}">
<title>{{ m.title }}</title>
<style>
:root {
  --ink: #111827; --muted: #4b5563; --faint: #6b7280; --line: #d9dee5; --soft: #f4f6f8;
  --accent: #1f4e8c; --warn-bg: #fff7e6; --warn-line: #d97706; --warn-ink: #7c2d12;
  --note-bg: #eef4fb; --res-bg: #f3f0fb; --res-line: #6d28d9;
}
* { box-sizing: border-box; }
body { margin: 0; background: #ffffff; color: var(--ink);
  font: 15px/1.55 -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, "DejaVu Sans", sans-serif; }
main { max-width: 1040px; margin: 0 auto; padding: 28px 16px 64px; }
h1 { font-size: 27px; line-height: 1.25; margin: 0 0 6px; }
h2 { font-size: 21px; margin: 42px 0 10px; padding-top: 10px; border-top: 2px solid var(--ink); }
h3 { font-size: 16px; margin: 22px 0 6px; }
h4 { font-size: 14px; margin: 16px 0 4px; color: var(--muted); }
p { margin: 6px 0 10px; }
a { color: var(--accent); }
.meta { display: grid; grid-template-columns: max-content 1fr; gap: 2px 14px; margin: 14px 0; font-size: 14px; }
.meta dt { color: var(--faint); }
.meta dd { margin: 0; }
nav.toc { background: var(--soft); border-radius: 6px; padding: 10px 14px; font-size: 14px; margin: 16px 0; }
nav.toc ol { margin: 4px 0; padding-left: 20px; columns: 2; column-gap: 28px; }
{% if not pdf %}@media (max-width: 640px) { nav.toc ol { columns: 1; } .meta { grid-template-columns: 1fr; } }{% endif %}
.tablewrap { {% if not pdf %}overflow-x: auto; {% endif %}margin: 8px 0 12px; }
table { border-collapse: collapse; font-size: 13px; width: auto; }
th, td { border-bottom: 1px solid var(--line); padding: 4px 8px; text-align: left; vertical-align: top; }
th { background: var(--soft); font-weight: 600; }
td.num, th.num { text-align: right; font-variant-numeric: tabular-nums; }
table.kv th { background: none; color: var(--muted); font-weight: normal; }
.box { padding: 8px 14px; margin: 12px 0; border-radius: 0 6px 6px 0; }
.box h3, .box h4 { margin: 4px 0; }
.box ul { margin: 4px 0; padding-left: 18px; }
.warnbox { background: var(--warn-bg); border-left: 4px solid var(--warn-line); color: var(--warn-ink); }
.warnbox h3, .warnbox h4 { color: var(--warn-ink); }
.licbox { background: var(--note-bg); border-left: 4px solid var(--accent); }
.resbox { background: var(--res-bg); border-left: 4px solid var(--res-line); }
.note { color: var(--muted); font-size: 13px; }
td .note, th .note { font-size: inherit; }
figure { margin: 18px 0 22px; page-break-inside: avoid; break-inside: avoid; }
figure img { max-width: 100%; height: auto; border: 1px solid var(--line); border-radius: 4px; display: block; }
figcaption { font-size: 13.5px; color: #1f2937; margin-top: 6px; }
.step-meta { font-size: 13px; color: var(--muted); }
.refs li { margin-bottom: 7px; font-size: 13.5px; }
.refs .unknown { color: #991b1b; }
.params { font-size: 12.5px; }
code { font-family: ui-monospace, Menlo, "DejaVu Sans Mono", monospace; font-size: 12.5px; background: var(--soft);
  padding: 0 3px; border-radius: 3px; }
details { margin: 8px 0; }
summary { cursor: pointer; color: var(--accent); }
footer { margin-top: 48px; color: var(--faint); font-size: 12.5px; border-top: 1px solid var(--line); padding-top: 10px; }
{% if pdf %}
@page { size: A4; margin: 15mm 12mm 16mm 12mm;
  @bottom-left { content: "{{ m.title|css_string }} · research output, not a clinical finding"; font-size: 7pt; color: #6b7280; font-family: "DejaVu Sans", sans-serif; }
  @bottom-right { content: "page " counter(page) " of " counter(pages); font-size: 7pt; color: #6b7280; font-family: "DejaVu Sans", sans-serif; } }
body { font-size: 9.5pt; line-height: 1.4; }
main { max-width: none; padding: 0; }
h1 { font-size: 18pt; } h2 { font-size: 14pt; margin-top: 18pt; break-after: avoid; } h3, h4 { break-after: avoid; }
nav.toc ol { columns: 2; }
table { font-size: 7pt; width: 100%; }
th, td { padding: 1.5pt 3pt; overflow-wrap: break-word; }
td:first-child { overflow-wrap: anywhere; min-width: 40mm; }
thead { display: table-header-group; }
tr { break-inside: avoid; }
figure img { max-height: 225mm; width: auto; max-width: 100%; }
figcaption { font-size: 8pt; }
.refs li { font-size: 8pt; }
table.params { width: auto; font-size: 7pt; } .params code { font-size: 7pt; }
a { color: inherit; text-decoration: none; }
{% endif %}
</style>
</head>
<body>
<main>
<header>
<h1>{{ m.title }}</h1>
<dl class="meta">
  <dt>Report written</dt><dd>{{ m.generated }}</dd>
  {% if m.workflows %}<dt>Workflow</dt><dd>{{ m.workflows|join('; ') }}</dd>{% endif %}
  <dt>Recordings</dt><dd>{{ m.recordings|length }}</dd>
  <dt>Steps</dt><dd>{% for s in m.sections %}{{ s.label }}{% if not loop.last %}, {% endif %}{% else %}none{% endfor %}</dd>
  {% if m.missing_apps %}<dt>Not linked</dt><dd>{% for a in m.missing_apps %}{{ a }}{% if m.port[a] %} (port <code>{{ m.port[a] }}</code>){% endif %}{% if not loop.last %}, {% endif %}{% endfor %}</dd>{% endif %}
  {% if m.datasets %}<dt>Data</dt><dd>{% for d in m.datasets %}{% if d.url %}<a href="{{ d.url }}">{{ d.title }}</a>{% else %}{{ d.title }}{% endif %}{% if not loop.last %}; {% endif %}{% endfor %}</dd>{% endif %}
</dl>
</header>

<section class="box resbox" id="research">
<h3>Research output, not a clinical finding</h3>
<p>Every number, figure and fit in this report was produced automatically by research software from the recordings.
Heart rate, heart rate variability, blood pressure, baroreflex sensitivity, thresholds and EC50 values describe these
recordings under their conditions (species, anaesthesia, electrodes, calibration); they are not a clinical ECG or
blood pressure assessment, and thresholds are not dosing recommendations. Published reference values are shown for
orientation only. Check the figures against the recordings before interpreting the numbers.</p>
</section>

{% if m.licences %}
<section id="licence" class="box licbox">
<h3>Usage and licence</h3>
<p>Parts of this analysis come with terms of use. Respect them when you use or share the results.</p>
<ul>{% for l in m.licences %}<li><b><a href="#{{ l.anchor }}">{{ l.step }}</a>:</b> {{ licence_text(l) }}</li>{% endfor %}</ul>
</section>
{% endif %}

<nav class="toc"><b>Contents</b>
<ol>
  <li><a href="#recordings">Recordings</a></li>
  <li><a href="#key">Key results</a></li>
  {% for s in m.sections %}<li><a href="#{{ s.anchor }}">{{ s.title }}</a>{% if s.warnings %} ({{ s.warnings|length }} warning{{ 's' if s.warnings|length != 1 }}){% endif %}</li>{% endfor %}
  <li><a href="#methods">Methods</a></li>
  <li><a href="#software">Software &amp; provenance</a></li>
  <li><a href="#references">References</a></li>
  <li><a href="#acknowledgements">Acknowledgements</a></li>
  <li><a href="#cite">How to cite</a></li>
  {% if m.issues %}<li><a href="#inputs">Notes on the inputs</a></li>{% endif %}
</ol></nav>

{% if m.warnings_total %}
<section class="box warnbox" id="warnings">
<h3>Warnings ({{ m.warnings_total }})</h3>
<p>The steps reported warnings; read them in each section before interpreting its results:
{% for s in m.sections if s.warnings %}<a href="#{{ s.anchor }}">{{ s.label }}</a> {{ s.warnings|length }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>
</section>
{% endif %}

<section id="recordings">
<h2>1. Recordings</h2>
{% if m.recordings %}
<p>{{ m.recordings|length }} recording{{ 's' if m.recordings|length != 1 }}{% if m.has_dataset %}, as physio-import listed them (<code>recordings.csv</code>){% else %}, as the linked steps describe them{% endif %}.
"Signals" are the channel types physio-import found. A step that did not analyse a recording says why in the last
column: a missing signal (no blood pressure, no stimulation) is not a failure.</p>
<div class="tablewrap"><table>
<thead><tr><th>Recording</th><th>Subject</th><th>Species</th><th class="num">Duration</th>{% if m.has_recorded %}<th class="num">Covered by samples</th>{% endif %}<th>Signals</th>{% if m.has_age %}<th>Age</th>{% endif %}{% if m.has_sex %}<th>Sex</th>{% endif %}<th>Steps with results</th><th>Not analysed (step: why)</th></tr></thead>
<tbody>{% for r in m.recordings %}<tr><td>{{ r.recording_id }}</td><td>{{ r.subject or '–' }}</td><td>{{ r.species }}</td><td class="num">{{ r.duration }}</td>{% if m.has_recorded %}<td class="num">{{ r.recorded or '' }}</td>{% endif %}<td>{{ r.types }}</td>{% if m.has_age %}<td>{{ r.age }}</td>{% endif %}{% if m.has_sex %}<td>{{ r.sex }}</td>{% endif %}<td>{{ r.steps|join(', ') or '–' }}</td><td>{% for n in r.not_analysed %}{{ n }}{% if not loop.last %}<br>{% endif %}{% else %}–{% endfor %}</td></tr>
{% endfor %}</tbody></table></div>
{% if m.has_recorded %}<p class="note">"Covered by samples" is shown where it is shorter than the duration: the recording has gaps (trial-by-trial acquisition).</p>{% endif %}
{% else %}
<p class="note">No recordings were found in the linked steps' outputs.</p>
{% endif %}

{% if m.glance.rows and m.glance.cols %}
<h3>At a glance</h3>
<p>One row per recording with a headline number of each linked step; each step's section has the full table, its
figures and its warnings. {{ m.sections[0].research if m.sections else '' }}</p>
<div class="tablewrap"><table>
<thead><tr>{% for h in m.glance.header %}<th{% if loop.index0 > 0 %} class="num"{% endif %}>{{ h }}</th>{% endfor %}</tr></thead>
<tbody>{% for r in m.glance.rows %}<tr><td>{{ r.recording_id }}</td>{% for c in r.cells %}<td class="num">{{ c }}</td>{% endfor %}</tr>
{% endfor %}</tbody></table></div>
{% endif %}
</section>

{%- macro refvalues(t) -%}
{% if t.refs %}
<h4>Published reference values</h4>
<div class="tablewrap"><table>
<thead><tr><th>Measure</th><th>Species</th><th>Reference</th><th>Population and method</th><th>Source</th></tr></thead>
<tbody>{% for r in t.refs %}<tr><td>{{ r.label }}</td><td>{{ r.species }}</td><td>{{ r.text }}{% if r.note %} <span class="note">({{ r.note }})</span>{% endif %}</td><td>{{ r.population }}</td><td>{{ r.n|refs }}{% if r.from_step %} <span class="note">(given by {{ r.from_step }})</span>{% endif %}</td></tr>
{% endfor %}</tbody></table></div>
{% endif %}
{% if t.no_ref_species %}<p class="note">No published reference values are built in for {{ t.no_ref_species|join(', ') }} recordings: compare them with your own controls.</p>{% endif %}
{%- endmacro -%}

<section id="key">
<h2>2. Key results</h2>
{% if not m.key.any %}
<p class="note">None of the linked steps has resting heart rate, blood pressure or dose-response results (link ecg-hrv's
<code>hrv</code>, bp-resp's <code>bp</code> or stim-dose-response's <code>responses</code> output).</p>
{% endif %}
{% if m.key.hrv %}
<h3>Heart rate and heart rate variability (whole recording)</h3>
<p>From ecg-hrv (<a href="#{{ m.key.hrv.anchor }}">section</a>), over each whole recording, stimulation included when
there was any. Numbers are copied from the step's summary.</p>
{% for n in m.key.hrv.notices %}<p class="note">{{ n }}</p>{% endfor %}
{{ table(m.key.hrv) }}
{{ refvalues(m.key.hrv) }}
{% endif %}
{% if m.key.bp %}
<h3>Blood pressure, baroreflex and respiration</h3>
<p>From bp-resp (<a href="#{{ m.key.bp.anchor }}">section</a>). Pressures and baroreflex slopes exist only for
calibrated pressure channels.</p>
{% for n in m.key.bp.notices %}<p class="note">{{ n }}</p>{% endfor %}
{{ table(m.key.bp) }}
{% if m.key.bp.has_checks %}<p class="note">Checks: an abrupt level step (a finger cuff re-calibrating, a transducer re-zeroed or moved) or a large drift makes the absolute pressures doubtful; beat-to-beat changes and BRS are less affected. A channel named here was chosen among several of that type. Details in the bp-resp section.</p>{% endif %}
{{ refvalues(m.key.bp) }}
{% endif %}
{% if (m.key.hrv and m.key.hrv.refs) or (m.key.bp and m.key.bp.refs) %}<p class="note"><b>About the reference values.</b> {{ m.key.caveat }}</p>{% endif %}
{% if m.key.dose %}
{% set d = m.key.dose %}
<h3>Thresholds, EC50 and neural fulcrum</h3>
<p>From stim-dose-response (<a href="#{{ d.anchor }}">section</a>): {{ d.n_fits }} fit{{ 's' if d.n_fits != 1 }}
({{ d.subjects|length }} subject{{ 's' if d.subjects|length != 1 }}{% if d.pooled %}, plus pooled fits{% endif %}),
{{ d.n_threshold }} with a threshold reached and {{ d.n_ec50 }} with an EC50. One row per subject, series and
parameter varied with the others held fixed; the threshold is the lowest level whose response exceeds the threshold
criterion, the EC50 the level of half the maximum change of a sigmoid fit ("–" when the chosen model is linear or none).</p>
{% for n in d.notices %}<div class="box resbox"><p>{{ n }}</p></div>{% endfor %}
{% if d.fits %}{% if d.fits.rows %}{{ table(d.fits) }}{% endif %}
{% if d.n_upper or d.n_blanked or d.n_single %}<p class="note">{% if d.n_upper %}"≤" ({{ d.n_upper }} row{{ 's' if d.n_upper != 1 }}): an upper bound, because the next lower level was not tested or not analysed; the true threshold may be lower. {% endif %}{% if d.n_blanked %}"Fit blanked" ({{ d.n_blanked }}): the response changes sign along the parameter, so stim-dose-response leaves the monotone fit's EC50, maximum and slope empty and gives the crossing in the fulcrum table. {% endif %}{% if d.n_single %}{{ d.n_single }} group{{ 's' if d.n_single != 1 }} with only one level of the parameter tested (no fit, no threshold) {{ 'are' if d.n_single != 1 else 'is' }} left out of this table; <code>tables/dose_response.csv</code> lists every row.{% endif %}</p>{% endif %}
{% if d.fits.criteria %}<p class="note">Threshold criterion (from fits.csv): {% for c in d.fits.criteria %}{{ c.series }}: {{ c.criterion }}{% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}{% endif %}
{% if d.fulcrum %}
<h4>Neural fulcrum</h4>
<p class="note">The amplitude where the heart-rate response to the trains changes sign at a fixed frequency (Ardell et
al. 2017 define the fulcrum for chronic, duty-cycled vagus nerve stimulation in conscious animals; read the notice above).</p>
{{ table(d.fulcrum) }}
{% endif %}
{% endif %}
</section>

{% for s in m.sections %}
<section id="{{ s.anchor }}">
<h2>{{ s.index }}. {{ s.title }}</h2>
<p class="step-meta">{{ s.label }} {{ s.version }}{% if s.variant %} · variant {{ s.variant }}{% endif %} · {{ s.n_recordings }} recording{{ 's' if s.n_recordings != 1 }}{% if s.wall_seconds is not none %} · ran {{ s.wall_seconds|duration }}{% endif %}{% if s.refs %} · references {{ s.refs|refs }}{% endif %}</p>

{% for n in s.notices %}<div class="box resbox"><h4>Read this first</h4><p>{{ n }}</p></div>{% endfor %}
{% if s.licence %}<div class="box licbox"><h4>Usage and licence</h4><p>{{ licence_text(s.licence) }}</p></div>{% endif %}

{% if s.about %}<p>{{ s.about }}</p>{% else %}<p class="note">No description is built into this report for <code>{{ s.app }}</code>; its results are shown as the app wrote them.</p>{% endif %}

{% if s.warnings %}
<div class="box warnbox"><h4>Warnings ({{ s.warnings|length }})</h4>
<ul>{% for w in s.warnings[:s.warnings_visible] if not pdf %}<li>{{ w }}</li>{% endfor %}{% for w in s.warnings if pdf %}<li>{{ w }}</li>{% endfor %}</ul>
{% if not pdf and s.warnings|length > s.warnings_visible %}<details><summary>{{ s.warnings|length - s.warnings_visible }} more</summary><ul>{% for w in s.warnings[s.warnings_visible:] %}<li>{{ w }}</li>{% endfor %}</ul></details>{% endif %}
</div>
{% endif %}

{% if s.qc %}
{% set q = s.qc %}
<h3>Signal quality per recording</h3>
<p>{{ q.n }} recording{{ 's' if q.n != 1 }}: {{ q.with_flags }} with at least one flagged channel ({{ q.n_flagged }} flagged channel{{ 's' if q.n_flagged != 1 }} in all).</p>
<div class="tablewrap"><table>
<thead><tr><th>Recording</th><th class="num">Duration</th><th class="num">Covered by samples</th><th class="num">Channels</th><th>Signals</th><th>Flagged channels</th>{% if q.has_uncal %}<th>Uncalibrated</th>{% endif %}<th class="num">Trials</th><th class="num">Markers</th><th class="num">NWB Inspector messages</th></tr></thead>
<tbody>{% for r in q.rows %}<tr><td>{{ r.recording_id }}</td><td class="num">{{ r.duration }}</td><td class="num">{{ r.recorded }}</td><td class="num">{{ r.n_channels }}</td><td>{{ r.types }}</td><td>{{ r.flagged }}</td>{% if q.has_uncal %}<td>{{ r.uncalibrated or '–' }}</td>{% endif %}<td class="num">{{ r.trials }}</td><td class="num">{{ r.markers }}</td><td class="num">{{ r.inspector }}</td></tr>
{% endfor %}</tbody></table></div>
<p class="note">Flat: the signal does not change; saturated: stuck at the minimum or maximum (a clipped amplifier or transducer); noisy: no structure from one sample to the next. A flagged ECG or pressure channel can make every later number of that recording unreliable.{% if not q.has_uncal %} Which channels are uncalibrated is in physio-import's <code>channels.csv</code> (its <code>physio</code> output) and in each step's notice.{% endif %}</p>
{% endif %}

{% if s.checks %}
<h3>Checks to read before the numbers</h3>
{{ table(s.checks) }}
{% endif %}

{% if s.headline %}
<h3>Headline numbers per recording</h3>
{{ table(s.headline) }}
<p class="note">{{ s.research }}</p>
{% elif s.n_recordings == 0 %}
<p class="note">This step reported no recordings{% if s.skipped %} (see "Not analysed" below){% endif %}.</p>
{% endif %}

{% if s.skipped %}
<h4>Not analysed</h4>
<ul class="note">{% for g in s.skipped %}<li>{{ g.reason }}: {{ g.ids|length }} ({{ g.ids[:6]|join(', ') }}{% if g.ids|length > 6 %}, ...{% endif %})</li>{% endfor %}</ul>
{% endif %}

{% if s.figures %}
<h3>Figures</h3>
{% for f in s.figures %}
<figure>{% if f.ok %}<img src="{{ f.pdf_src if pdf else f.dest }}" alt="{{ f.rel }}" width="{{ f.w }}" height="{{ f.h }}">{% else %}<p class="note">(figure could not be read: {{ f.rel }})</p>{% endif %}
<figcaption><b>Figure {{ f.number }}.</b> {{ f.caption or '(no caption in summary.json)' }}</figcaption></figure>
{% endfor %}
{% endif %}
{% if s.omitted %}<p class="note">{{ s.omitted|length }} more figure{{ 's' if s.omitted|length != 1 }} of this step (MAX_FIGURES = {{ m.parameters.MAX_FIGURES }}) are in the report's folder{% if pdf %} <code>{{ s.omitted[0].dest.rsplit('/', 1)[0] }}/</code>, next to report.html, which links them.{% else %}:
{% for f in s.omitted %}<a href="{{ f.dest }}">{{ f.rel }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.{% endif %}</p>{% endif %}

{% if s.tables %}
<h4>Tables</h4>
<p class="note">Copied to <code>{{ s.tables_dir }}/</code> next to this report:</p>
<ul class="note">{% for t in s.tables %}<li><code>{{ t.rel }}</code>{% if t.caption %}: {{ t.caption }}{% endif %}{% if not t.exists %} <b>(listed but missing)</b>{% endif %}</li>{% endfor %}</ul>
{% endif %}

{% if s.parameters %}
{% if pdf %}<h4>Parameters</h4>{% else %}<details><summary>Parameters ({{ s.parameters|length }})</summary>{% endif %}
<div class="tablewrap"><table class="kv params">{% for k, v in s.parameters.items() %}<tr><th><code>{{ k }}</code></th><td>{{ v|plain }}</td></tr>{% endfor %}</table></div>
{% if not pdf %}</details>{% endif %}
{% endif %}
</section>
{% endfor %}

<section id="methods">
<h2>Methods</h2>
{% for s in m.sections %}
<p><b>{{ s.title }}.</b> {% if s.methods %}{{ s.methods }}{% else %}Computed with {{ s.app }}{% endif %}{% if s.refs %} {{ s.refs|refs }}{% endif %}. The step ran as <code>{{ s.app }}</code> {{ s.version }} on {{ s.n_recordings }} recording{{ 's' if s.n_recordings != 1 }}; its parameters are listed in <a href="#{{ s.anchor }}">section {{ s.index }}</a>.</p>
{% endfor %}
<p>The report was written by <code>physio-report</code> {{ m.version }} (Pennsieve), which copies each step's numbers,
figures, captions and warnings from its <code>summary.json</code>, and its software versions, parameters and
citations from its <code>provenance.json</code>; it does not recompute or interpret them. The published reference
values next to the resting numbers are built into the report with their sources.</p>
</section>

<section id="software">
<h2>Software &amp; provenance</h2>
<div class="tablewrap"><table>
<thead><tr><th>Step</th><th>Version</th><th>Tools</th><th class="num">Run time</th><th class="num">Peak memory</th><th>Recordings</th></tr></thead>
<tbody>{% for s in m.sections %}<tr><td>{{ s.label }}</td><td>{{ s.version or '–' }}</td>
<td class="params">{% for k, v in s.tools.items() %}{{ k }} {{ v }}{% if not loop.last %}; {% endif %}{% endfor %}</td>
<td class="num">{{ s.wall_seconds|duration if s.wall_seconds is not none else '–' }}</td>
<td class="num">{{ s.peak_rss_mb|mb }}</td><td>{% for k, v in s.statuses.items() %}{{ k }} {{ v }}{% if not loop.last %}, {% endif %}{% else %}–{% endfor %}</td></tr>{% endfor %}</tbody>
</table></div>
<p class="note">Run time and peak memory are what each step recorded in its provenance.json (the whole step).</p>
</section>

<section id="references">
<h2>References</h2>
<p class="note">The works each step cites in its provenance.json, the sources of the reference values, and the
datasets. Author lists, titles and journals come from the Pennsieve apps' CITATION.cff files and from Crossref,
DataCite and PubMed.</p>
<ol class="refs">
